# Copy to .env. Never put a private key or seed phrase here: SolGraph does not use one.
# One AI key is enough. Gemini has a free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# SOLGRAPH_MODEL=gemini-3.5-flash   # or claude-sonnet-5-5; picked from the key if unset
# devnet (default) | testnet | mainnet. Reads only on every network.
SOLGRAPH_NETWORK=devnet
# SOLGRAPH_RPC_URL=https://your-private-rpc
# Unset = in-memory graph. Set after `docker compose up -d`:
# SOLGRAPH_PG_DSN=postgresql://solgraph:solgraph@127.0.0.1:5455/solgraph
